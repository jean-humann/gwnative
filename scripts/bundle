#!/bin/sh
# Assemble "Guild Wars.app" around the release binary.
#
# Why a bundle at all: macOS Game Mode only considers applications whose
# LSApplicationCategoryType names a game category, and a category can only be
# declared in an Info.plist. Game Mode is worth being eligible for — it gives
# the frontmost full-screen game priority on the performance cores and doubles
# the Bluetooth polling rate for controllers and AirPods — and no amount of
# runtime configuration substitutes for it. A bare executable is simply not a
# candidate.
#
# Everything else a bundle brings follows from the same file: a real bundle
# identifier instead of a nil one, a name for the application menu, a Retina
# backing store, and a Finder icon to launch rather than a path to type.
#
# Usage: scripts/bundle [output.app]
set -e

cd "$(dirname "$0")/.."
root=$PWD
app=${1:-$root/dist/Guild Wars.app}

# The next operation replaces this path recursively. Requiring an application
# bundle name keeps a typo such as `scripts/bundle .` from turning the checkout
# itself into the output directory and deleting it first.
case ${app##*/} in
?*.app) ;;
*)
	echo "[bundle] output must be a named .app bundle: $app" >&2
	exit 1
	;;
esac

cargo build --release

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources/web"

version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)

# CFBundleVersion has to increase for every build of a given identifier, and the
# package version does not: patching an older line publishes a lower one. The
# commit count is monotonic on this project's linear history, needs no state
# outside the repository, and is the same number in CI as on this machine. A
# build from a tarball with no git history falls back to the version, which is
# wrong in the same way it was wrong before this line existed and no worse.
build=$(git rev-list --count HEAD 2>/dev/null || echo "$version")
sed -e "s/__VERSION__/$version/g" -e "s/__BUILD__/$build/g" \
	packaging/Info.plist >"$app/Contents/Info.plist"

# Pre-bundle-identifier legacy, but Launch Services still reads it and it costs
# eight bytes.
printf 'APPL????' >"$app/Contents/PkgInfo"

cp target/release/gwnative "$app/Contents/MacOS/gwnative"

# Finder, the Dock and Launch Services read this one; the copy inside the binary
# is what a `cargo run` build installs for itself. Both come from scripts/icon,
# so they cannot drift.
cp packaging/AppIcon.icns "$app/Contents/Resources/AppIcon.icns"

# Keep the source-code licence and the separate game-material notice inside the
# distributed application. Neither is useful only in the checkout that built
# it, and the latter is the durable copy behind the shorter in-app disclosure.
cp LICENSE NOTICE.md "$app/Contents/Resources/"

# The shell only. Both client builds are fetched live from ArenaNet; bundling
# either one would freeze the game at the packaged build.
for path in web/*.js web/*.html; do
	case ${path##*/} in
	Gw.js|Gw.jspi.*) continue ;;
	# Nothing at runtime imports these, and `paths::seed_web` copies whatever the
	# bundle carries into the live web root, so shipping them would leave a
	# player's Application Support directory holding this app's test suite.
	*.test.js) continue ;;
	esac
	cp "$path" "$app/Contents/Resources/web/"
done

# ------------------------------------------------------------------ updater --
# Sparkle, and the two Info.plist keys without which it refuses to start. Both
# conditions have to hold — the framework is committed, so in practice this is
# asking whether anyone has generated a signing key yet. Without one the bundle
# is built exactly as it was before Sparkle existed, and src/release.rs remains
# the update path: a feed nobody can sign is a feed nothing should trust.
sparkle=
if [ -d packaging/sparkle/Sparkle.framework ] && [ -f packaging/sparkle/public-key.txt ]; then
	sparkle="$app/Contents/Frameworks/Sparkle.framework"
	mkdir -p "$app/Contents/Frameworks"
	# ditto rather than cp -R: the framework is built out of symlinks, and one
	# of them (Versions/Current) is what every other one resolves through.
	ditto packaging/sparkle/Sparkle.framework "$sparkle"

	# The XPC services exist to reach the network and the filesystem from
	# inside an App Sandbox. This application is not sandboxed, so they are
	# never loaded — and each is a nested bundle that would otherwise have to
	# be signed, notarized and stapled for nothing. Both the directory and the
	# symlink pointing at it, or the bundle keeps a dangling link.
	rm -rf "$sparkle/Versions/B/XPCServices" "$sparkle/XPCServices"

	# Upstream ships universal. This application has one arm64 slice, so the
	# other half of every binary here is bytes that could not run even if
	# something tried. Takes the framework from 3.0 MB to about 1.6 MB.
	for macho in Sparkle Autoupdate Updater.app/Contents/MacOS/Updater; do
		lipo -thin arm64 "$sparkle/Versions/B/$macho" \
			-output "$sparkle/Versions/B/$macho.thin"
		mv "$sparkle/Versions/B/$macho.thin" "$sparkle/Versions/B/$macho"
	done

	# MIT asks that the notice travel with the binary, and the framework does
	# not carry one — upstream keeps LICENSE beside it rather than inside it.
	cp packaging/sparkle/LICENSE "$app/Contents/Resources/Sparkle-LICENSE.txt"

	# The feed is derived from the repository rather than written out, so the
	# place the update check looks and the place the Help menu opens cannot
	# drift apart. `releases/latest/download/` is GitHub's redirect to an asset
	# of the newest release, which is where the release workflow puts the
	# appcast — so the URL never has to name a version.
	feed=$(sed -n 's|^repository = "\(.*\)"$|\1|p' Cargo.toml | head -1)
	# The two switches, present so that Sparkle does not ask for itself. Left
	# alone it puts up its own permission prompt on the second launch; this
	# application already asks the same question in its settings panel, and
	# being asked twice by two different dialogs is worse than either. False
	# here is only the starting point — src/updater.rs seeds the real answer
	# from the profile on the first launch, and Sparkle owns it afterwards.
	/usr/libexec/PlistBuddy \
		-c "Add :SUFeedURL string $feed/releases/latest/download/appcast.xml" \
		-c "Add :SUPublicEDKey string $(cat packaging/sparkle/public-key.txt)" \
		-c "Add :SUEnableAutomaticChecks bool false" \
		-c "Add :SUAutomaticallyUpdate bool false" \
		"$app/Contents/Info.plist" >/dev/null
fi

# Symbols live beside the bundle rather than inside it: they are half the build
# output, nothing at runtime reads them, and `sample` and Instruments find a
# .dSYM by UUID wherever it sits on the volume.
rm -rf "$root/dist/gwnative.dSYM"
if [ -d target/release/gwnative.dSYM ]; then
	cp -R target/release/gwnative.dSYM "$root/dist/gwnative.dSYM"
fi

identity=$(scripts/sign-identity)
if [ -z "$identity" ]; then
	echo "[bundle] no code-signing identity found; the saved login will not" \
		"survive this build. Set GWNATIVE_SIGN_IDENTITY to choose one." >&2
else
	# --identifier is redundant with CFBundleIdentifier and passed anyway, so
	# that a plist edit cannot silently change which application the keychain
	# thinks is asking.
	#
	# --options runtime on every bundle, not only on the released one. The
	# hardened runtime is a precondition for notarization, and it is also a set
	# of things the process is no longer allowed to do — loading a library
	# nobody signed, being attached to by a debugger, honouring DYLD_*. Turning
	# it on only at release would mean the first build that runs under those
	# rules is the one nobody gets to test. No entitlements go with it: the only
	# hardened-runtime exception this application could want is JIT, and the
	# JavaScript that needs one runs in WebKit's own WebContent process under
	# Apple's signature rather than in this one.
	#
	# The two things that differ between a bundle for here and a bundle for
	# other people, and they differ for the same reason: both are about who is
	# allowed to look inside the process.
	#
	# --timestamp costs a round trip to Apple's server and fails outright
	# without a network, so a local build does not ask for one; a notarized
	# signature must have one, and must keep working after the certificate
	# expires, which is the whole point of countersigning it.
	#
	# packaging/debug.entitlements is get-task-allow and nothing else — without
	# it the hardened runtime refuses `sample`, `leaks` and Instruments, which
	# is most of how this project is measured, and the dSYM copied out below
	# would have nothing to symbolicate. Notarization rejects that entitlement,
	# as it should: it is permission to be read by any process the user runs.
	if [ -n "$GWNATIVE_RELEASE" ]; then
		set -- --timestamp
	else
		set -- --timestamp=none --entitlements packaging/debug.entitlements
	fi

	# Innermost first, and the app last. A signature seals what is inside it, so
	# signing the bundle before its framework produces a seal over the old
	# contents and `codesign --verify --deep` reports the framework as modified.
	#
	# The nested pieces are signed on their own terms, not this application's:
	# no --identifier, because each already has one and Sparkle's installer
	# launches Autoupdate by the identity it was built with, and
	# --preserve-metadata so the entitlement upstream gives Autoupdate survives
	# being re-signed. The one thing they do share is --options runtime, which
	# notarization requires of every executable in the bundle and not only the
	# main one. Nothing here gets packaging/debug.entitlements: get-task-allow
	# on a helper that installs software is a wider hole than it is on the game.
	if [ -n "$sparkle" ]; then
		[ -n "$GWNATIVE_RELEASE" ] && inner=--timestamp || inner=--timestamp=none
		for nested in \
			"$sparkle/Versions/B/Autoupdate" \
			"$sparkle/Versions/B/Updater.app" \
			"$sparkle"; do
			codesign --force --sign "$identity" --options runtime \
				--preserve-metadata=identifier,entitlements "$inner" "$nested" 2>&1 |
				sed 's/^/[bundle] /' >&2
		done
	fi

	codesign --force --sign "$identity" --identifier com.gwnative.app \
		--options runtime "$@" "$app" 2>&1 |
		sed 's/^/[bundle] /' >&2
	# --deep here as well as in scripts/release, because the framework is the
	# first thing this bundle has ever carried that the seal alone does not
	# prove: --strict checks the app against its own signature, and --deep is
	# what walks into Contents/Frameworks and checks Sparkle against its.
	codesign --verify --deep --strict "$app"
fi

echo "[bundle] $app"
echo "[bundle] open it from Finder, or run \"$app/Contents/MacOS/gwnative\"" \
	"to keep the diagnostics on your terminal"
