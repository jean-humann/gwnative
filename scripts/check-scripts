#!/bin/sh
# Parse repository-owned maintenance scripts without executing their effects.
set -e

cd "$(dirname "$0")/.."

for script in \
	scripts/appcast \
	scripts/bundle \
	scripts/certificate-sign \
	scripts/check-scripts \
	scripts/icon \
	scripts/publish \
	scripts/release \
	scripts/sign-identity \
	scripts/signed-run; do
	sh -n "$script"
done

python3 -m py_compile \
	scripts/benchmark \
	scripts/benchmarklib.py \
	scripts/check-distribution \
	scripts/check-docs \
	scripts/check-release-artifacts \
	scripts/release-manifest \
	scripts/check-support-matrix \
	scripts/check-trust-policy \
	scripts/client-certify \
	scripts/sbom
python3 -m unittest discover -s tests -p 'benchmark_test.py'
python3 scripts/check-support-matrix --self-test
scripts/sbom --self-test
scripts/check-release-artifacts --self-test
scripts/release-manifest --self-test
echo "scripts: shell and Python syntax ok"
