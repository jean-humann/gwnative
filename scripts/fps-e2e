#!/usr/bin/env python3
"""Run the authenticated FPS E2E as a JSPI/Asyncify presentation matrix."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--character", required=True)
    parser.add_argument("--profile")
    parser.add_argument("--seconds", type=float, default=20)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--refresh-hz", type=float)
    parser.add_argument(
        "--fps",
        type=int,
        help=(
            "Guild Wars frame ceiling; defaults to the rounded --refresh-hz "
            "because the client otherwise retains ArenaNet's 90 FPS default"
        ),
    )
    parser.add_argument("--render-scale", type=float, choices=(1.0, 1.5, 2.0))
    parser.add_argument("--expect-map-id", type=int)
    parser.add_argument("--minimum-agents", type=int, default=0)
    parser.add_argument("--minimum-fps", type=float)
    parser.add_argument("--maximum-p95-ms", type=float)
    parser.add_argument(
        "--runtimes",
        nargs="+",
        choices=("auto", "jspi", "asyncify"),
        default=("jspi", "asyncify"),
    )
    parser.add_argument(
        "--isolation-modes",
        nargs="+",
        choices=("on", "off"),
        default=("on", "off"),
    )
    args = parser.parse_args()
    if not 1 <= args.seconds <= 60:
        parser.error("--seconds must be between 1 and 60")
    if args.fps is not None and args.fps <= 0:
        parser.error("--fps must be positive")
    client_fps = args.fps
    if client_fps is None and args.refresh_hz is not None:
        client_fps = round(args.refresh_hz)
    if client_fps is not None and not 1 <= client_fps <= 1_000:
        parser.error("the effective frame ceiling must be between 1 and 1000")

    if args.output_dir.exists() and any(args.output_dir.iterdir()):
        parser.error("--output-dir must be absent or empty")
    args.output_dir.mkdir(parents=True, exist_ok=True)
    cells = []
    for runtime in args.runtimes:
        for isolation in args.isolation_modes:
            name = f"{runtime}-isolation-{isolation}"
            artifact = args.output_dir / f"{name}.json"
            command = [
                str(ROOT / "scripts/e2e"),
                "--character",
                args.character,
                "--runtime",
                runtime,
                "--frame-isolation",
                isolation,
                "--benchmark-seconds",
                str(args.seconds),
                "--benchmark-output",
                str(artifact),
                "--benchmark-only",
                "--minimum-agents",
                str(args.minimum_agents),
            ]
            if args.profile:
                command.extend(["--profile", args.profile])
            if args.render_scale is not None:
                command.extend(["--render-scale", str(args.render_scale)])
            if client_fps is not None:
                command.extend(["--fps", str(client_fps)])
            for option, value in [
                ("--refresh-hz", args.refresh_hz),
                ("--expect-map-id", args.expect_map_id),
                ("--minimum-fps", args.minimum_fps),
                ("--maximum-p95-ms", args.maximum_p95_ms),
            ]:
                if value is not None:
                    command.extend([option, str(value)])
            print(f"[fps-e2e] {name}", flush=True)
            completed = subprocess.run(command, cwd=ROOT, check=False)
            cells.append({
                "name": name,
                "runtime": runtime,
                "frameIsolation": isolation,
                "exitCode": completed.returncode,
                "artifact": artifact.name if artifact.is_file() else None,
            })

    manifest = {
        "schemaVersion": 1,
        "secondsPerCell": args.seconds,
        "clientFrameLimit": client_fps,
        "cells": cells,
    }
    (args.output_dir / "matrix.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    failures = [cell["name"] for cell in cells if cell["exitCode"] != 0]
    if failures:
        print(f"[fps-e2e] FAIL: {', '.join(failures)}", file=sys.stderr)
        return 1
    print(f"[fps-e2e] PASS: {args.output_dir}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
