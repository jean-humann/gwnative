#!/usr/bin/env python3
"""Check local Markdown links and heading anchors without network access."""

from __future__ import annotations

import re
import sys
from collections import defaultdict
from os import walk
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
IGNORED_DIRECTORIES = {".git", "dist", "node_modules", "target"}


def markdown_files() -> list[Path]:
    """Every repository Markdown file, excluding generated dependency trees."""
    result: list[Path] = []
    for directory, names, files in walk(ROOT):
        names[:] = sorted(name for name in names if name not in IGNORED_DIRECTORIES)
        result.extend(
            Path(directory) / name for name in sorted(files) if name.lower().endswith(".md")
        )
    return sorted(result)


FILES = markdown_files()

HEADING = re.compile(r"^#{1,6}\s+(.+?)\s*#*\s*$", re.MULTILINE)
LINK = re.compile(r"!?\[[^\]]*]\(([^)\s]+)(?:\s+['\"][^)]*['\"])?\)")


def slug(text: str) -> str:
    """The GitHub heading shape used by links in this repository."""
    text = re.sub(r"<[^>]+>", "", text)
    text = re.sub(r"[`*_~]", "", text).strip().lower()
    text = re.sub(r"[^\w -]", "", text)
    return re.sub(r"[\s-]+", "-", text).strip("-")


def anchors(markdown: str) -> set[str]:
    """Heading anchors, including GitHub's numeric suffix for duplicates."""
    seen: defaultdict[str, int] = defaultdict(int)
    result: set[str] = set()
    for heading in HEADING.findall(markdown):
        base = slug(heading)
        count = seen[base]
        result.add(base if count == 0 else f"{base}-{count}")
        seen[base] += 1
    return result


def main() -> int:
    problems: list[str] = []
    documents = {path: path.read_text() for path in FILES if path.is_file()}

    for source, markdown in documents.items():
        for raw in LINK.findall(markdown):
            link = raw.removeprefix("<").removesuffix(">")
            if link.startswith(("http://", "https://", "mailto:")):
                continue

            target_text, separator, anchor = link.partition("#")
            target = source if not target_text else (source.parent / target_text).resolve()
            shown = source.relative_to(ROOT)

            if not target.exists():
                problems.append(f"{shown}: missing {link}")
                continue
            if separator and target.suffix.lower() == ".md":
                target_markdown = documents.get(target)
                if target_markdown is None:
                    target_markdown = target.read_text()
                if anchor not in anchors(target_markdown):
                    problems.append(f"{shown}: missing heading #{anchor} in {target.relative_to(ROOT)}")

    if problems:
        print("\n".join(problems), file=sys.stderr)
        return 1
    print(f"documentation: {len(documents)} files, local links and anchors ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
