#!/usr/bin/env python3
"""Generate a checkable hash lineage for a reviewed gwnative release."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path
from urllib.parse import urlparse


ROOT = Path(__file__).resolve().parent.parent
SPARKLE = "{http://www.andymatuschak.org/xml-namespaces/sparkle}"


class ManifestError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ManifestError(message)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def tree_sha256(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
        relative = path.relative_to(root).as_posix().encode()
        mode = f"{path.lstat().st_mode & 0o7777:o}".encode()
        if path.is_symlink():
            kind, content = b"L", os.readlink(path).encode()
        elif path.is_file():
            kind, content = b"F", path.read_bytes()
        elif path.is_dir():
            kind, content = b"D", b""
        else:
            raise ManifestError(f"unsupported bundle path: {path}")
        digest.update(kind + b"\0" + mode + b"\0" + relative + b"\0" + content + b"\0")
    return digest.hexdigest()


def artifact(path: Path) -> dict:
    require(path.is_file(), f"missing release artifact: {path}")
    return {"name": path.name, "size": path.stat().st_size, "sha256": sha256(path)}


def bundle_file(app: Path, relative: str) -> dict:
    path = app / relative
    require(path.is_file(), f"bundle is missing {relative}")
    return {"path": relative, "size": path.stat().st_size, "sha256": sha256(path)}


def appcast_lineage(path: Path, archive: Path) -> dict:
    try:
        root = ET.parse(path).getroot()
    except ET.ParseError as error:
        raise ManifestError(f"invalid appcast XML: {error}") from error
    enclosure = root.find("./channel/item/enclosure")
    require(enclosure is not None, "appcast has no enclosure")
    url = enclosure.get("url", "")
    length = enclosure.get("length", "")
    signature = enclosure.get(f"{SPARKLE}edSignature", "")
    require(Path(urlparse(url).path).name == archive.name, "appcast names a different ZIP")
    require(length.isdigit(), "appcast enclosure length is not numeric")
    require(int(length) == archive.stat().st_size, "appcast enclosure length differs from ZIP")
    require(bool(signature), "appcast enclosure has no Sparkle signature")
    return {
        "enclosureUrl": url,
        "enclosureLength": int(length),
        "enclosureSha256": sha256(archive),
        "signatureSha256": hashlib.sha256(signature.encode()).hexdigest(),
    }


def cargo_version() -> str:
    for line in (ROOT / "Cargo.toml").read_text().splitlines():
        if line.startswith("version = "):
            return line.split('"')[1]
    raise ManifestError("Cargo.toml has no package version")


def reviewed_commit(tag: str) -> str:
    expected = subprocess.check_output(
        ["git", "rev-parse", "--verify", f"{tag}^{{commit}}"], cwd=ROOT, text=True
    ).strip()
    head = subprocess.check_output(
        ["git", "rev-parse", "--verify", "HEAD"], cwd=ROOT, text=True
    ).strip()
    require(expected == head, f"{tag} points at {expected}, not reviewed HEAD {head}")
    return head


def build_document(
    tag: str, commit: str, app: Path, archive: Path, image: Path, appcast: Path
) -> dict:
    version = cargo_version()
    require(tag == f"v{version}", f"tag {tag} does not match Cargo.toml version {version}")
    require(app.is_dir(), f"missing application bundle: {app}")
    return {
        "schemaVersion": 1,
        "source": {"tag": tag, "reviewedCommit": commit},
        "product": {"name": "gwnative", "version": version},
        "bundle": {
            "path": app.name,
            "treeSha256": tree_sha256(app),
            "binary": bundle_file(app, "Contents/MacOS/gwnative"),
            "infoPlist": bundle_file(app, "Contents/Info.plist"),
            "sbom": bundle_file(app, "Contents/Resources/gwnative.cdx.json"),
        },
        "artifacts": {
            "zip": artifact(archive),
            "dmg": artifact(image),
            "appcast": artifact(appcast),
        },
        "updateLineage": appcast_lineage(appcast, archive),
    }


def render(document: dict) -> bytes:
    return (json.dumps(document, indent=2, sort_keys=True) + "\n").encode()


def write_atomic(path: Path, content: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as temporary:
        temporary.write(content)
        temporary_path = Path(temporary.name)
    temporary_path.replace(path)


def fixture_app(root: Path) -> Path:
    app = root / "Guild Wars.app"
    for relative, content in (
        ("Contents/MacOS/gwnative", b"signed-binary-fixture"),
        ("Contents/Info.plist", b"plist-fixture"),
        ("Contents/Resources/gwnative.cdx.json", b"sbom-fixture"),
    ):
        path = app / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(content)
    return app


def self_test() -> None:
    with tempfile.TemporaryDirectory(prefix="gwnative-lineage-") as directory:
        root = Path(directory)
        app = fixture_app(root)
        version = cargo_version()
        archive = root / f"gwnative-{version}.zip"
        image = root / f"gwnative-{version}.dmg"
        appcast = root / "appcast.xml"
        archive.write_bytes(b"updater-archive-fixture")
        image.write_bytes(b"disk-image-fixture")
        appcast.write_text(
            f'''<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"><channel><item><enclosure url="https://example.invalid/v{version}/{archive.name}" length="{archive.stat().st_size}" sparkle:edSignature="fixture-signature"/></item></channel></rss>'''
        )
        first = build_document(f"v{version}", "a" * 40, app, archive, image, appcast)
        require(render(first) == render(build_document(f"v{version}", "a" * 40, app, archive, image, appcast)), "manifest is not deterministic")
        appcast.write_text(appcast.read_text().replace(f'length="{archive.stat().st_size}"', 'length="1"'))
        try:
            build_document(f"v{version}", "a" * 40, app, archive, image, appcast)
        except ManifestError:
            pass
        else:
            raise ManifestError("self-test accepted an appcast/ZIP length mismatch")


def main(arguments: list[str]) -> int:
    version = cargo_version()
    parser = argparse.ArgumentParser()
    parser.add_argument("--tag", default=f"v{version}")
    parser.add_argument("--bundle", type=Path, default=ROOT / "dist/Guild Wars.app")
    parser.add_argument("--zip", type=Path, default=ROOT / f"dist/gwnative-{version}.zip")
    parser.add_argument("--dmg", type=Path, default=ROOT / f"dist/gwnative-{version}.dmg")
    parser.add_argument("--appcast", type=Path, default=ROOT / "dist/appcast.xml")
    destination = parser.add_mutually_exclusive_group()
    destination.add_argument("--output", type=Path, default=ROOT / "dist/release-manifest.json")
    destination.add_argument("--check", type=Path)
    parser.add_argument("--self-test", action="store_true")
    options = parser.parse_args(arguments)
    if options.self_test:
        self_test()
        print("release manifest: deterministic lineage fixture ok")
        return 0

    commit = reviewed_commit(options.tag)
    document = build_document(
        options.tag,
        commit,
        options.bundle.resolve(),
        options.zip.resolve(),
        options.dmg.resolve(),
        options.appcast.resolve(),
    )
    content = render(document)
    if options.check is not None:
        require(options.check.read_bytes() == content, f"stale release manifest: {options.check}")
        print(f"release manifest: verified {options.check}")
    else:
        write_atomic(options.output.resolve(), content)
        print(f"release manifest: wrote {options.output.resolve()}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, ValueError, subprocess.CalledProcessError, ManifestError) as error:
        print(f"release manifest: {error}", file=sys.stderr)
        raise SystemExit(1)
