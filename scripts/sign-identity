#!/bin/sh
# Print the code-signing identity to use, or nothing if there is none.
#
# Deliberately discovered rather than hardcoded: the common name embeds a
# developer's account, and these files are committed. `GWNATIVE_SIGN_IDENTITY`
# overrides the search for anyone with more than one certificate installed.
#
# Shared by scripts/signed-run, scripts/bundle and scripts/release so that a
# bare `cargo run` build, a packaged one and a published one are signed by the
# same identity. They have to be: the keychain matches the saved login against
# the signature, so two identities would mean two applications and one of them
# without an account.
#
# Developer ID first, because it is the only identity Apple will notarize and
# therefore the only one a published build can carry. Preferring it *everywhere*
# rather than only in the release path is the point — if development signed with
# Apple Development and releases with Developer ID, the designated requirement
# would differ between them and every player moving from one to the other would
# be asked to sign in again. One certificate, one requirement, one saved login.
#
# Changing which certificate is preferred is itself that event, once: the first
# build after this file started answering differently is a new application to
# the keychain, and the login has to be re-entered. It does not recur.
set -e

if [ -n "$GWNATIVE_SIGN_IDENTITY" ]; then
	echo "$GWNATIVE_SIGN_IDENTITY"
	exit 0
fi

identities=$(security find-identity -v -p codesigning 2>/dev/null || true)

# In preference order. The last fallback is whatever is installed, which on a
# machine with only a self-signed certificate is still stable across rebuilds
# and so still keeps the saved login readable — it just cannot be notarized.
for prefix in "Developer ID Application:" "Apple Development:"; do
	identity=$(echo "$identities" | sed -n "s/.*\"\($prefix.*\)\"/\1/p" | head -1)
	if [ -n "$identity" ]; then
		echo "$identity"
		exit 0
	fi
done

echo "$identities" | sed -n 's/.*"\(.*\)"/\1/p' | head -1
