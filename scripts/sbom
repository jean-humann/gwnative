#!/usr/bin/env python3
"""Generate the deterministic CycloneDX SBOM shipped with gwnative."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path
from urllib.parse import quote


ROOT = Path(__file__).resolve().parent.parent
LOCK = ROOT / "Cargo.lock"
SPARKLE_ROOT = ROOT / "packaging/sparkle"
SPARKLE_REF = "pkg:generic/Sparkle@2.9.4"


class SbomError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SbomError(message)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def tree_sha256(root: Path) -> str:
    """Hash names, file bytes, and symlink targets without following links."""
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
        relative = path.relative_to(root).as_posix().encode()
        if path.is_symlink():
            kind, content = b"L", os.readlink(path).encode()
        elif path.is_file():
            kind, content = b"F", path.read_bytes()
        elif path.is_dir():
            kind, content = b"D", b""
        else:
            raise SbomError(f"unsupported vendored path: {path}")
        digest.update(kind + b"\0" + relative + b"\0" + content + b"\0")
    return digest.hexdigest()


def cargo_metadata() -> dict:
    result = subprocess.run(
        ["cargo", "metadata", "--locked", "--offline", "--format-version", "1"],
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
    )
    return json.loads(result.stdout)


def lock_checksums() -> dict[tuple[str, str, str | None], str]:
    document = tomllib.loads(LOCK.read_text())
    return {
        (package["name"], package["version"], package.get("source")): package["checksum"]
        for package in document["package"]
        if "checksum" in package
    }


def package_ref(package: dict) -> str:
    return f"pkg:cargo/{quote(package['name'], safe='')}@{quote(package['version'], safe='')}"


def component(package: dict, checksums: dict) -> dict:
    item = {
        "type": "application" if package["name"] == "gwnative" else "library",
        "bom-ref": package_ref(package),
        "name": package["name"],
        "version": package["version"],
        "purl": package_ref(package),
        "licenses": [{"expression": package["license"]}],
        "properties": [{"name": "cargo:package-id", "value": package["id"]}],
    }
    checksum = checksums.get((package["name"], package["version"], package["source"]))
    if checksum is not None:
        item["hashes"] = [{"alg": "SHA-256", "content": checksum}]
    return item


def build_document() -> dict:
    metadata = cargo_metadata()
    packages = metadata["packages"]
    root = next(
        (package for package in packages if package["name"] == "gwnative"), None
    )
    require(root is not None, "cargo metadata contains no gwnative package")
    require(all(package.get("license") for package in packages), "a Cargo package has no licence")

    refs = {package["id"]: package_ref(package) for package in packages}
    cargo_components = [component(package, lock_checksums()) for package in packages]
    root_component = next(item for item in cargo_components if item["name"] == "gwnative")
    components = [item for item in cargo_components if item["name"] != "gwnative"]
    components.append(
        {
            "type": "framework",
            "bom-ref": SPARKLE_REF,
            "name": "Sparkle",
            "version": "2.9.4",
            "purl": SPARKLE_REF,
            "licenses": [{"license": {"name": "LicenseRef-Sparkle-2.9.4"}}],
            "externalReferences": [
                {
                    "type": "distribution",
                    "url": "https://github.com/sparkle-project/Sparkle/releases/tag/2.9.4",
                }
            ],
            "properties": [
                {"name": "gwnative:vendored-tree-sha256", "value": tree_sha256(SPARKLE_ROOT)}
            ],
        }
    )

    dependencies = []
    for node in metadata["resolve"]["nodes"]:
        direct = sorted(refs[item] for item in node["dependencies"])
        if node["id"] == root["id"]:
            direct.append(SPARKLE_REF)
            direct.sort()
        dependencies.append({"ref": refs[node["id"]], "dependsOn": direct})
    dependencies.append({"ref": SPARKLE_REF, "dependsOn": []})

    return {
        "bomFormat": "CycloneDX",
        "specVersion": "1.6",
        "version": 1,
        "metadata": {
            "tools": {
                "components": [
                    {"type": "application", "name": "gwnative scripts/sbom"}
                ]
            },
            "component": root_component,
            "properties": [
                {"name": "gwnative:cargo-lock-sha256", "value": sha256(LOCK)}
            ],
        },
        "components": sorted(components, key=lambda item: item["bom-ref"]),
        "dependencies": sorted(dependencies, key=lambda item: item["ref"]),
    }


def render(document: dict) -> bytes:
    return (json.dumps(document, indent=2, sort_keys=True) + "\n").encode()


def validate(document: dict) -> None:
    require(document.get("bomFormat") == "CycloneDX", "SBOM is not CycloneDX")
    require(document.get("specVersion") == "1.6", "SBOM is not CycloneDX 1.6")
    require("serialNumber" not in document, "deterministic SBOM must not contain a UUID")
    root = document.get("metadata", {}).get("component", {})
    require(root.get("name") == "gwnative", "SBOM root is not gwnative")
    references = {item.get("bom-ref") for item in document.get("components", [])}
    require(SPARKLE_REF in references, "SBOM omits vendored Sparkle")
    dependencies = {item.get("ref") for item in document.get("dependencies", [])}
    require(root.get("bom-ref") in dependencies, "SBOM omits root dependency graph")


def self_test() -> None:
    first = build_document()
    validate(first)
    require(render(first) == render(build_document()), "SBOM generation is not deterministic")
    corrupted = json.loads(render(first))
    corrupted["specVersion"] = "1.5"
    try:
        validate(corrupted)
    except SbomError:
        pass
    else:
        raise SbomError("self-test accepted the wrong CycloneDX version")


def main(arguments: list[str]) -> int:
    parser = argparse.ArgumentParser()
    choice = parser.add_mutually_exclusive_group()
    choice.add_argument("--output", type=Path)
    choice.add_argument("--check", type=Path)
    choice.add_argument("--self-test", action="store_true")
    options = parser.parse_args(arguments)

    if options.self_test:
        self_test()
        print("sbom: deterministic CycloneDX dependency inventory ok")
        return 0

    document = build_document()
    validate(document)
    expected = render(document)
    if options.check is not None:
        require(options.check.read_bytes() == expected, f"stale SBOM: {options.check}")
        print(f"sbom: verified {options.check}")
        return 0

    output = (options.output or ROOT / "dist/gwnative.cdx.json").resolve()
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=output.parent, delete=False) as temporary:
        temporary.write(expected)
        temporary_path = Path(temporary.name)
    temporary_path.replace(output)
    print(f"sbom: wrote {output}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, ValueError, subprocess.CalledProcessError, SbomError) as error:
        print(f"sbom: {error}", file=sys.stderr)
        raise SystemExit(1)
