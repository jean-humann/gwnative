#!/bin/sh
# Put a finished build on GitHub: the disk image people download by hand, the
# archive Sparkle downloads on their behalf, and the feed that points at it.
#
# The release is created as a draft and published at the end, which is the whole
# reason this is a script and not three commands. `releases/latest` is what the
# feed URL resolves through, so the moment a release stops being a draft it
# becomes the answer every running copy of the application gets — and if the
# appcast has not been uploaded yet, that answer is a 404. A draft is invisible
# to that lookup, so everything can be assembled and checked first and the
# release becomes current in one step.
#
# The notes are the release's own, rendered to HTML by GitHub so that what
# Sparkle shows in its update panel is what the release page shows: the same
# text, the same links, laid out the same way. Nothing is written twice.
#
# Usage: scripts/publish <tag>
# Environment:
#   SPARKLE_PRIVATE_KEY  passed through to scripts/appcast; unset means the
#                        login keychain
#   GH_TOKEN             for CI. Locally, an authenticated `gh` is enough.
set -e

cd "$(dirname "$0")/.."
root=$PWD

say() { echo "[publish] $*" >&2; }
die() {
	say "$*"
	exit 1
}

tag=$1
[ -n "$tag" ] || die "usage: scripts/publish <tag>"

version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)
# A tag naming a different version than Cargo.toml declares would publish a
# download whose filename, Info.plist and update feed all disagree with the
# release they are attached to.
[ "$tag" = "v$version" ] ||
	die "tag $tag does not match version $version in Cargo.toml"

# appcast.xml takes its build number and repository URL from this checkout.
# Require the exact tagged source that produced the release, with no local
# edits able to change either value after the artifact was signed.
[ -z "$(git status --porcelain 2>/dev/null)" ] ||
	die "the working tree has uncommitted changes; publish from the tagged source"
tag_commit=$(git rev-parse --verify "$tag^{commit}" 2>/dev/null) ||
	die "tag $tag does not exist in this checkout"
head_commit=$(git rev-parse --verify HEAD)
[ "$tag_commit" = "$head_commit" ] ||
	die "tag $tag points at $tag_commit, but this checkout is $head_commit"

dmg="$root/dist/gwnative-$version.dmg"
zip="$root/dist/gwnative-$version.zip"
[ -f "$dmg" ] || die "$dmg does not exist; run scripts/release first"
[ -f "$zip" ] || die "$zip does not exist; run scripts/release first"

# --------------------------------------------------------------- the draft ---
# Re-runnable on purpose: the step this most often has to be repeated after is
# an upload that failed halfway, and re-cutting the release would throw away the
# notes somebody may have edited by then.
if release_is_draft=$(gh release view "$tag" --json isDraft -q .isDraft 2>/dev/null); then
	[ "$release_is_draft" = true ] ||
		die "$tag is already public; refusing to replace live update assets"
	say "$tag exists already; replacing its files"
	gh release upload "$tag" "$dmg" "$zip" --clobber
else
	# --verify-tag: describe a tag that already exists, rather than creating
	# one pointing at whatever happens to be checked out here.
	gh release create "$tag" "$dmg" "$zip" \
		--draft --verify-tag --generate-notes \
		--title "Guild Wars $version" >/dev/null
	say "drafted $tag"
fi

# ---------------------------------------------------------------- the feed ---
notes=$root/dist/release-notes.html
slug=$(gh repo view --json nameWithOwner -q .nameWithOwner)
body=$(gh release view "$tag" --json body -q .body)

# GitHub's own renderer, with the repository as context, so `#12` and `@name`
# become the links they are on the release page rather than literal text. Not
# fatal if it fails: an update with a link where its notes should be is worse
# than one with them, and better than no update.
rm -f "$notes"
if [ -n "$body" ] &&
	gh api -X POST /markdown -f mode=gfm -f context="$slug" \
		-f text="$body" >"$notes" 2>/dev/null; then
	say "release notes rendered ($(wc -c <"$notes" | tr -d ' ') bytes)"
else
	rm -f "$notes"
	say "the release notes could not be rendered; the feed will link to them"
fi

SPARKLE_PRIVATE_KEY=${SPARKLE_PRIVATE_KEY:-} scripts/appcast "$zip" "$notes"
gh release upload "$tag" "$root/dist/appcast.xml" --clobber

# ------------------------------------------------------------------- live ---
# --latest is explicit rather than implied: it is the flag that decides what
# releases/latest/download/appcast.xml resolves to, which is to say what every
# installed copy of the application is about to be offered.
gh release edit "$tag" --draft=false --latest >/dev/null
say "published $tag"
say "  $(gh release view "$tag" --json url -q .url)"
