#!/bin/sh
# Sign and immediately verify a reviewed certificate feed with its dedicated
# Ed25519 key. The key is base64-encoded PKCS#8 DER in CI and a generic-password
# item in the local login Keychain.
set -eu

cd "$(dirname "$0")/.."

[ "${1:-}" = "--publish" ] || {
	echo "usage: scripts/certificate-sign --publish FEED [SIGNATURE]" >&2
	echo "Candidate generation never receives the production certificate key." >&2
	exit 2
}
feed=${2:-}
signature=${3:-"$feed.sig"}
[ -n "$feed" ] && [ -f "$feed" ] || {
	echo "certificate-sign: feed does not exist: $feed" >&2
	exit 2
}

openssl=
for candidate in "${OPENSSL:-}" openssl \
	/opt/homebrew/opt/openssl@3/bin/openssl \
	/usr/local/opt/openssl@3/bin/openssl; do
	[ -n "$candidate" ] || continue
	command -v "$candidate" >/dev/null 2>&1 || continue
	case $("$candidate" version 2>/dev/null) in
	"OpenSSL 3"* | "OpenSSL 4"*) openssl=$candidate && break ;;
	esac
done
[ -n "$openssl" ] || {
	echo "certificate-sign: OpenSSL 3 or newer is required" >&2
	exit 1
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
private=$work/private.der
if [ -n "${CERTIFICATE_PRIVATE_KEY:-}" ]; then
	printf '%s' "$CERTIFICATE_PRIVATE_KEY" | "$openssl" base64 -d -A >"$private"
elif command -v security >/dev/null 2>&1; then
	security find-generic-password \
		-a gwnative-certificates \
		-s gwnative-certificate-signing \
		-w | "$openssl" base64 -d -A >"$private"
else
	echo "certificate-sign: CERTIFICATE_PRIVATE_KEY is not set" >&2
	exit 1
fi
chmod 600 "$private"

"$openssl" pkeyutl -sign -rawin -keyform DER \
	-inkey "$private" -in "$feed" -out "$work/signature.raw"
"$openssl" base64 -A -in "$work/signature.raw" >"$work/signature"
printf '\n' >>"$work/signature"

{
	printf '302a300506032b6570032100' | xxd -r -p
	"$openssl" base64 -d -A <certificates/public-key.txt
} >"$work/public.der"
"$openssl" pkeyutl -verify -pubin -keyform DER \
	-inkey "$work/public.der" -rawin -in "$feed" \
	-sigfile "$work/signature.raw" >/dev/null

temporary="$signature.tmp"
cp "$work/signature" "$temporary"
mv "$temporary" "$signature"
echo "certificate-sign: wrote and verified $signature" >&2
