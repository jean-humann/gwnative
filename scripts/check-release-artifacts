#!/usr/bin/env python3
"""Inspect source, app, ZIP, and DMG release payloads without publishing them."""

from __future__ import annotations

import argparse
import hashlib
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from functools import lru_cache
from pathlib import Path, PurePosixPath


ROOT = Path(__file__).resolve().parent.parent


class ArtifactError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ArtifactError(message)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


@lru_cache(maxsize=1)
def runtime_artifact_names() -> frozenset[str]:
    source = (ROOT / "src/patch.rs").read_text()
    names: set[str] = set()
    for constant in ("CLIENT_ARTIFACTS", "COMMON_ARTIFACTS"):
        match = re.search(rf"const {constant}[^=]*=\s*\[(.*?)\];", source, re.DOTALL)
        require(match is not None, f"could not read src/patch.rs {constant}")
        names.update(re.findall(r'"([^"]+)"', match.group(1)))
    snapshot = re.search(r'pub const SNAPSHOT[^=]*=\s*"([^"]+)";', source)
    require(snapshot is not None, "could not read src/patch.rs SNAPSHOT")
    names.add(snapshot.group(1))
    return frozenset(name.lower() for name in names)


def forbidden_name(name: str) -> bool:
    leaf = PurePosixPath(name.replace("\\", "/")).name.lower()
    if leaf.startswith("._"):
        leaf = leaf[2:]
    return leaf in runtime_artifact_names() or leaf.endswith(".dat")


def safe_member(name: str) -> None:
    path = PurePosixPath(name.replace("\\", "/"))
    require(not path.is_absolute(), f"archive contains an absolute path: {name}")
    require(".." not in path.parts, f"archive escapes its extraction root: {name}")
    require(not forbidden_name(name), f"archive contains a client/game artifact: {name}")


def archive_members(path: Path) -> list[str]:
    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as archive:
            return archive.namelist()
    if tarfile.is_tarfile(path):
        with tarfile.open(path) as archive:
            return [member.name for member in archive.getmembers()]
    raise ArtifactError(f"unsupported archive: {path}")


def check_archive_inventory(path: Path) -> None:
    require(path.is_file(), f"missing archive: {path}")
    members = archive_members(path)
    require(members, f"archive is empty: {path}")
    for name in members:
        safe_member(name)


def extract_archive(path: Path, destination: Path) -> None:
    check_archive_inventory(path)
    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as archive:
            archive.extractall(destination)
        return
    with tarfile.open(path) as archive:
        try:
            archive.extractall(destination, filter="data")
        except TypeError:
            archive.extractall(destination)


def source_root(extracted: Path) -> Path:
    children = [path for path in extracted.iterdir() if path.name != "__MACOSX"]
    if len(children) == 1 and children[0].is_dir():
        return children[0]
    return extracted


def run_distribution_checker(source: Path, app: Path | None = None) -> None:
    checker = source / "scripts/check-distribution"
    require(checker.is_file(), f"source archive is missing {checker.relative_to(source)}")
    command = [sys.executable, str(checker), "--self-test"]
    if app is not None:
        command.append(str(app))
    subprocess.run(command, cwd=source, check=True)


def check_source_archive(path: Path) -> None:
    with tempfile.TemporaryDirectory(prefix="gwnative-source-") as directory:
        extracted = Path(directory)
        extract_archive(path, extracted)
        run_distribution_checker(source_root(extracted))


def find_product_app(root: Path) -> Path:
    matches = [
        path
        for path in root.rglob("*.app")
        if (path / "Contents/MacOS/gwnative").is_file()
    ]
    require(len(matches) == 1, f"expected one gwnative app, found {len(matches)}")
    return matches[0]


def check_bundle(path: Path) -> None:
    run_distribution_checker(ROOT, path.resolve())


def check_zip(path: Path) -> None:
    with tempfile.TemporaryDirectory(prefix="gwnative-zip-") as directory:
        extracted = Path(directory)
        extract_archive(path, extracted)
        check_bundle(find_product_app(extracted))


def check_dmg(path: Path) -> None:
    require(platform.system() == "Darwin", "DMG inspection requires macOS")
    require(path.is_file(), f"missing disk image: {path}")
    with tempfile.TemporaryDirectory(prefix="gwnative-dmg-") as directory:
        mountpoint = Path(directory) / "mount"
        mountpoint.mkdir()
        subprocess.run(
            [
                "hdiutil",
                "attach",
                "-nobrowse",
                "-readonly",
                "-mountpoint",
                str(mountpoint),
                str(path),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
        )
        try:
            for candidate in mountpoint.rglob("*"):
                require(
                    not forbidden_name(candidate.name),
                    f"disk image contains a client/game artifact: {candidate}",
                )
            check_bundle(find_product_app(mountpoint))
        finally:
            subprocess.run(
                ["hdiutil", "detach", str(mountpoint)],
                check=True,
                stdout=subprocess.DEVNULL,
            )


def check_lineage(
    manifest: Path, app: Path, archive: Path, image: Path, appcast: Path, tag: str
) -> None:
    subprocess.run(
        [
            str(ROOT / "scripts/release-manifest"),
            "--tag",
            tag,
            "--bundle",
            str(app),
            "--zip",
            str(archive),
            "--dmg",
            str(image),
            "--appcast",
            str(appcast),
            "--check",
            str(manifest),
        ],
        check=True,
    )


def install_candidate(active: Path, candidate: Path, expected: str, previous: Path) -> None:
    require(sha256(candidate) == expected, "candidate hash does not match its manifest")
    shutil.copy2(active, previous)
    os.replace(candidate, active)


def rollback(active: Path, previous: Path) -> None:
    require(previous.is_file(), "rollback artifact is missing")
    staged = active.with_suffix(".rollback")
    shutil.copy2(previous, staged)
    os.replace(staged, active)


def expect_failure(action, message: str) -> None:
    try:
        action()
    except ArtifactError:
        return
    raise ArtifactError(message)


def self_test() -> None:
    with tempfile.TemporaryDirectory(prefix="gwnative-artifact-test-") as directory:
        root = Path(directory)
        public = root / "public/Guild Wars.app/Contents/Resources"
        public.mkdir(parents=True)
        (public / "NOTICE.md").write_text("fixture")
        require(
            not any(forbidden_name(path.name) for path in public.rglob("*")),
            "clean public fixture was rejected",
        )
        forbidden = public / "Gw.dat"
        forbidden.write_bytes(b"canary-game-data")
        expect_failure(
            lambda: require(
                not any(forbidden_name(path.name) for path in public.rglob("*")),
                "public fixture contains game data",
            ),
            "self-test accepted game data in the public fixture",
        )
        forbidden.unlink()

        safe_zip = root / "safe.zip"
        with zipfile.ZipFile(safe_zip, "w") as archive:
            archive.writestr("Guild Wars.app/Contents/Resources/NOTICE.md", "fixture")
        check_archive_inventory(safe_zip)
        unsafe_zip = root / "unsafe.zip"
        with zipfile.ZipFile(unsafe_zip, "w") as archive:
            archive.writestr("Guild Wars.app/Contents/Resources/Gw.wasm", b"canary")
        expect_failure(
            lambda: check_archive_inventory(unsafe_zip),
            "self-test accepted an official client artifact in an archive",
        )

        active, candidate, previous = root / "active", root / "candidate", root / "previous"
        active.write_bytes(b"reviewed-v1")
        candidate.write_bytes(b"reviewed-v2")
        install_candidate(active, candidate, sha256(candidate), previous)
        require(active.read_bytes() == b"reviewed-v2", "update fixture did not install")
        rollback(active, previous)
        require(active.read_bytes() == b"reviewed-v1", "rollback fixture was not exact")
        candidate.write_bytes(b"tampered-v3")
        before = active.read_bytes()
        expect_failure(
            lambda: install_candidate(active, candidate, "0" * 64, previous),
            "self-test installed a candidate with a mismatched manifest",
        )
        require(active.read_bytes() == before, "refused update changed the active artifact")


def main(arguments: list[str]) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--source", type=Path, action="append", default=[])
    parser.add_argument("--bundle", type=Path, action="append", default=[])
    parser.add_argument("--zip", type=Path, action="append", default=[])
    parser.add_argument("--dmg", type=Path, action="append", default=[])
    parser.add_argument("--manifest", type=Path)
    parser.add_argument("--appcast", type=Path)
    parser.add_argument("--tag")
    options = parser.parse_args(arguments)

    if options.self_test:
        self_test()
    for path in options.source:
        check_source_archive(path.resolve())
    for path in options.bundle:
        check_bundle(path.resolve())
    for path in options.zip:
        check_zip(path.resolve())
    for path in options.dmg:
        check_dmg(path.resolve())
    if options.manifest is not None:
        require(len(options.bundle) == 1, "lineage check requires exactly one --bundle")
        require(len(options.zip) == 1, "lineage check requires exactly one --zip")
        require(len(options.dmg) == 1, "lineage check requires exactly one --dmg")
        require(options.appcast is not None, "lineage check requires --appcast")
        require(options.tag is not None, "lineage check requires --tag")
        check_lineage(
            options.manifest.resolve(),
            options.bundle[0].resolve(),
            options.zip[0].resolve(),
            options.dmg[0].resolve(),
            options.appcast.resolve(),
            options.tag,
        )
    require(
        options.self_test
        or options.source
        or options.bundle
        or options.zip
        or options.dmg
        or options.manifest,
        "provide --self-test, --source, --bundle, --zip, or --dmg",
    )
    print("release artifacts: inventory and update/rollback gates ok")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, ValueError, subprocess.CalledProcessError, ArtifactError) as error:
        print(f"release artifacts: {error}", file=sys.stderr)
        raise SystemExit(1)
