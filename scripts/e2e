#!/usr/bin/env python3
"""Run the signed native app through its event-driven test control plane.

The application—not this runner—reads the selected profile's Keychain item.
The runner receives only presence milestones and the short-lived loopback
capability. It performs no screen capture, OCR, focus polling, coordinate
clicking, arbitrary JavaScript evaluation or credential read.
"""

from __future__ import annotations

import argparse
import json
import math
import os
from pathlib import Path
import queue
import re
import signal
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request


ROOT = Path(__file__).resolve().parent.parent
TOKEN = re.compile(r"session token ([A-Za-z0-9_-]+)")
ORIGIN = re.compile(r" at (http://127\.0\.0\.1:\d+)/index\.html")
EMAIL = re.compile(r"(?i)\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b")
LONG_POLL_MS = 15_000


class Failure(RuntimeError):
    pass


def profile_web_root(
    profile: str | None,
    base: Path | None = None,
) -> Path:
    base = base or Path.home() / "Library/Application Support/gwnative"
    if not profile or profile == "default":
        return base / "web"
    valid = (
        1 <= len(profile) <= 64
        and profile not in {".", ".."}
        and all(
            character.isascii()
            and (character.isalnum() or character in "._-")
            for character in profile
        )
    )
    if not valid:
        raise Failure("profile is not a safe directory component")
    directory = base / "profiles" / profile
    if not (directory / "profile.json").is_file():
        raise Failure(f"profile {profile!r} does not exist")
    return directory / "web"


def run(command: list[str], **kwargs) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=ROOT, check=True, text=True, **kwargs)


def request_json(
    origin: str,
    path: str,
    token: str | None,
    *,
    method: str = "GET",
    body: dict[str, object] | None = None,
    expected: int = 200,
    timeout: float = 20,
) -> dict[str, object]:
    payload = json.dumps(body).encode() if body is not None else None
    headers = {"X-Gwnative-Token": token} if token else {}
    if payload is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(
        f"{origin}{path}",
        headers=headers,
        method=method,
        data=payload,
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            status = response.status
            response_body = response.read()
    except urllib.error.HTTPError as error:
        status = error.code
        response_body = error.read()
    if status != expected:
        raise Failure(f"{method} {path} answered {status}, expected {expected}")
    if not response_body:
        return {}
    try:
        return json.loads(response_body)
    except json.JSONDecodeError:
        # Refusal routes deliberately answer with plain text. The status is the
        # contract under test; carrying the body further adds no evidence.
        return {}


def output_reader(
    process: subprocess.Popen[str],
    events: queue.Queue[tuple[str, str]],
) -> None:
    assert process.stdout is not None
    for raw in process.stdout:
        line = raw.rstrip()
        token = TOKEN.search(line)
        origin = ORIGIN.search(line)
        if token:
            events.put(("token", token.group(1)))
            print("[gwnative] session token captured (redacted)")
        else:
            print(EMAIL.sub("<redacted-account>", line))
        if origin:
            events.put(("origin", origin.group(1)))


def wait_for_origin(
    events: queue.Queue[tuple[str, str]],
    timeout: float,
) -> tuple[str, str]:
    deadline = time.monotonic() + timeout
    token = None
    origin = None
    while time.monotonic() < deadline:
        try:
            kind, value = events.get(timeout=min(1, deadline - time.monotonic()))
        except queue.Empty:
            continue
        if kind == "token":
            token = value
        elif kind == "origin":
            origin = value
        if token and origin:
            return origin, token
    raise Failure("the signed app did not publish its loopback origin before timeout")


class EventStream:
    """A cursor over the server's bounded long-poll event log."""

    def __init__(self, origin: str, token: str) -> None:
        self.origin = origin
        self.token = token
        self.after = 0
        self.pending: list[dict[str, object]] = []

    def next_batch(self, deadline: float) -> list[dict[str, object]]:
        if self.pending:
            result, self.pending = self.pending, []
            return result
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return []
        wait_ms = min(LONG_POLL_MS, max(1, int(remaining * 1000)))
        query = urllib.parse.urlencode({"after": self.after, "waitMs": wait_ms})
        envelope = request_json(
            self.origin,
            f"/__e2e/v1/events?{query}",
            self.token,
            timeout=(wait_ms / 1000) + 3,
        )
        result = list(envelope.get("events", []))
        for event in result:
            self.after = max(self.after, int(event.get("sequence", 0)))
        return result

    def wait_for(
        self,
        kinds: set[str],
        timeout: float,
    ) -> dict[str, dict[str, object]]:
        deadline = time.monotonic() + timeout
        found: dict[str, dict[str, object]] = {}
        deferred: list[dict[str, object]] = []
        while time.monotonic() < deadline and not kinds.issubset(found):
            batch = self.next_batch(deadline)
            for index, event in enumerate(batch):
                kind = str(event.get("kind", ""))
                if kind in {"app-fail", "action-fail"}:
                    detail = event.get("detail", {})
                    raise Failure(f"{kind}: {detail.get('message', 'unknown failure')}")
                if kind in kinds:
                    found[kind] = event
                else:
                    deferred.append(event)
                if kinds.issubset(found):
                    deferred.extend(batch[index + 1 :])
                    break
        self.pending.extend(deferred)
        missing = kinds.difference(found)
        if missing:
            raise Failure(
                f"no {', '.join(sorted(missing))} event arrived within {timeout:.0f}s"
            )
        return found

    def wait_for_action(self, sequence: int, timeout: float) -> dict[str, object]:
        deadline = time.monotonic() + timeout
        deferred: list[dict[str, object]] = []
        while time.monotonic() < deadline:
            batch = self.next_batch(deadline)
            for index, event in enumerate(batch):
                kind = str(event.get("kind", ""))
                detail = event.get("detail", {})
                if kind == "app-fail":
                    raise Failure(f"app-fail: {detail.get('message', 'unknown failure')}")
                if kind == "action-fail" and detail.get("actionSequence") == sequence:
                    raise Failure(f"action failed: {detail.get('message', 'unknown failure')}")
                if kind == "action-complete" and detail.get("actionSequence") == sequence:
                    # A state milestone can share this response with the action
                    # acknowledgement. Keep everything else for the next wait
                    # instead of silently consuming it.
                    self.pending.extend(deferred)
                    self.pending.extend(batch[index + 1 :])
                    return event
                deferred.append(event)
        self.pending.extend(deferred)
        raise Failure(f"E2E action {sequence} was not acknowledged")

    def wait_for_action_event(
        self,
        sequence: int,
        kind: str,
        timeout: float,
    ) -> dict[str, object] | None:
        deadline = time.monotonic() + timeout
        deferred: list[dict[str, object]] = []
        while time.monotonic() < deadline:
            batch = self.next_batch(deadline)
            for index, event in enumerate(batch):
                event_kind = str(event.get("kind", ""))
                detail = event.get("detail", {})
                if event_kind in {"app-fail", "action-fail"}:
                    raise Failure(
                        f"{event_kind}: {detail.get('message', 'unknown failure')}"
                    )
                if (
                    event_kind == kind
                    and detail.get("actionSequence") == sequence
                ):
                    self.pending.extend(deferred)
                    self.pending.extend(batch[index + 1 :])
                    return event
                deferred.append(event)
        self.pending.extend(deferred)
        return None

    def wait_optional(self, kind: str, timeout: float) -> dict[str, object] | None:
        deadline = time.monotonic() + timeout
        deferred: list[dict[str, object]] = []
        while time.monotonic() < deadline:
            batch = self.next_batch(deadline)
            for index, event in enumerate(batch):
                event_kind = str(event.get("kind", ""))
                if event_kind in {"app-fail", "action-fail"}:
                    detail = event.get("detail", {})
                    raise Failure(f"{event_kind}: {detail.get('message', 'unknown failure')}")
                if event_kind == kind:
                    self.pending.extend(deferred)
                    self.pending.extend(batch[index + 1 :])
                    return event
                deferred.append(event)
        self.pending.extend(deferred)
        return None

    def wait_for_action_traffic(
        self,
        sequence: int,
        timeout: float,
        direction: str | None = None,
    ) -> dict[str, object] | None:
        deadline = time.monotonic() + timeout
        deferred: list[dict[str, object]] = []
        while time.monotonic() < deadline:
            batch = self.next_batch(deadline)
            for index, event in enumerate(batch):
                kind = str(event.get("kind", ""))
                detail = event.get("detail", {})
                if kind in {"app-fail", "action-fail"}:
                    raise Failure(f"{kind}: {detail.get('message', 'unknown failure')}")
                if (
                    kind == "client-traffic"
                    and detail.get("actionSequence") == sequence
                    and (
                        direction is None
                        or detail.get("direction") == direction
                    )
                ):
                    self.pending.extend(deferred)
                    self.pending.extend(batch[index + 1 :])
                    return event
                deferred.append(event)
        self.pending.extend(deferred)
        return None

    def wait_for_action_connection(
        self,
        sequence: int,
        timeout: float,
    ) -> dict[str, object] | None:
        deadline = time.monotonic() + timeout
        deferred: list[dict[str, object]] = []
        while time.monotonic() < deadline:
            batch = self.next_batch(deadline)
            for index, event in enumerate(batch):
                kind = str(event.get("kind", ""))
                detail = event.get("detail", {})
                if kind in {"app-fail", "action-fail"}:
                    raise Failure(f"{kind}: {detail.get('message', 'unknown failure')}")
                if kind == "socket-open" and detail.get("actionSequence") == sequence:
                    self.pending.extend(deferred)
                    self.pending.extend(batch[index + 1 :])
                    return event
                deferred.append(event)
        self.pending.extend(deferred)
        return None


def submit_action(
    origin: str,
    token: str,
    action: str,
    duration_ms: int | None = None,
) -> int:
    body: dict[str, object] = {"action": action}
    if duration_ms is not None:
        body["durationMs"] = duration_ms
    result = request_json(
        origin,
        "/__e2e/v1/actions",
        token,
        method="POST",
        body=body,
    )
    return int(result["sequence"])


def game_state_after(
    origin: str,
    token: str,
    after: int,
    wait_ms: int,
) -> dict[str, object] | None:
    query = urllib.parse.urlencode({"after": after, "waitMs": wait_ms})
    try:
        return request_json(
            origin,
            f"/__game/v1/state?{query}",
            token,
            timeout=(wait_ms / 1000) + 3,
        )
    except Failure as error:
        if "answered 404" in str(error):
            return None
        raise


def position(envelope: dict[str, object]) -> tuple[float, float]:
    state = envelope["state"]
    return float(state["playerX"]), float(state["playerY"])


def wait_for_ready_state(
    origin: str,
    token: str,
    revision: int,
    timeout: float,
) -> dict[str, object] | None:
    """Require stable ready state, retaining the latest diagnostic state."""
    deadline = time.monotonic() + timeout
    candidate: tuple[object, object] | None = None
    latest: dict[str, object] | None = None
    while time.monotonic() < deadline:
        remaining = deadline - time.monotonic()
        wait_ms = min(LONG_POLL_MS, max(1, int(remaining * 1000)))
        envelope = game_state_after(origin, token, revision, wait_ms)
        if envelope is None:
            continue
        latest = envelope
        revision = int(envelope["revision"])
        state = envelope.get("state", {})
        if state.get("status") != "ready":
            candidate = None
            continue
        identity = (state.get("mapId"), state.get("playerId"))
        if candidate == identity:
            return envelope
        candidate = identity
    return latest


def wait_for_position_change(
    origin: str,
    token: str,
    before: tuple[float, float],
    revision: int,
    timeout: float,
) -> tuple[float, float]:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        remaining = deadline - time.monotonic()
        wait_ms = min(LONG_POLL_MS, max(1, int(remaining * 1000)))
        envelope = game_state_after(origin, token, revision, wait_ms)
        if envelope is None:
            continue
        revision = int(envelope["revision"])
        if envelope.get("state", {}).get("status") != "ready":
            continue
        after = position(envelope)
        if math.dist(before, after) >= 1:
            return after
    raise Failure("movement input did not change the certified player position")


def terminate(process: subprocess.Popen[str]) -> None:
    if process.poll() is not None:
        return
    process.send_signal(signal.SIGINT)
    try:
        process.wait(timeout=8)
    except subprocess.TimeoutExpired:
        process.terminate()
        try:
            process.wait(timeout=4)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def main() -> int:
    # Keep long interactive runs observable even when stdout is redirected.
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--timeout", type=float, default=180)
    parser.add_argument(
        "--fps",
        type=int,
        help="exercise the optional client frame-rate ceiling",
    )
    parser.add_argument(
        "--character",
        help=(
            "pass the selected character through the official client argument "
            "contract for deterministic character selection"
        ),
    )
    parser.add_argument(
        "--profile",
        help=(
            "launch an existing isolated profile; the application selects that "
            "profile's Keychain item without exposing it to this runner"
        ),
    )
    parser.add_argument(
        "--no-gameplay",
        action="store_true",
        help="stop after Keychain, first-frame, page UI, and API-contract checks",
    )
    parser.add_argument(
        "--auth-timeout",
        type=float,
        default=180,
        help="allow this many seconds for interactive authentication and 2FA",
    )
    args = parser.parse_args()

    if sys.platform != "darwin":
        raise Failure("the native E2E runner requires macOS")
    if args.auth_timeout <= 0:
        raise Failure("--auth-timeout must be positive")

    run(["cargo", "build"])
    support_web = profile_web_root(args.profile)
    if not (support_web / "Gw.jspi.wasm").is_file():
        raise Failure(f"the installed client is missing from {support_web}")

    with tempfile.TemporaryDirectory(prefix="gwnative-e2e-") as temporary:
        scratch = Path(temporary)
        web_root = scratch / "web"
        web_root.mkdir()
        for source in (ROOT / "web").iterdir():
            if source.is_file():
                shutil.copy2(source, web_root / source.name)
        # The source tree intentionally does not version ArenaNet's artifacts
        # and can retain an older ignored copy. Overlay the installed client
        # onto the current page shell in a disposable root.
        for name in ("Gw.jspi.js", "Gw.jspi.wasm", "version.json"):
            source = support_web / name
            if not source.is_file():
                raise Failure(f"the installed client is missing {source}")
            shutil.copy2(source, web_root / name)

        environment = os.environ.copy()
        environment["GWNATIVE_E2E"] = "1"
        environment["GWNATIVE_PRINT_TOKEN"] = "1"
        environment["GWNATIVE_WEB_ROOT"] = str(web_root)
        # WKWebView suspends its animation-frame-driven client when macOS puts
        # the display to sleep. Mark the machine active before launch, then
        # hold display/system idle sleep only for this app process.
        subprocess.run(
            ["caffeinate", "-u", "-t", "1"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        command = [
            str(ROOT / "scripts/signed-run"),
            str(ROOT / "target/debug/gwnative"),
            "--no-update",
        ]
        if args.profile:
            command.extend(["--profile", args.profile])
        command.extend(["-autologin", "-windowed"])
        if args.character:
            command.extend(["-character", args.character])
        if args.fps is not None:
            if args.fps <= 0:
                raise Failure("--fps must be a positive integer")
            command.extend(["-fps", str(args.fps)])
        process = subprocess.Popen(
            command,
            cwd=ROOT,
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        inhibitor = subprocess.Popen(
            ["caffeinate", "-dims", "-w", str(process.pid)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        launch_events: queue.Queue[tuple[str, str]] = queue.Queue()
        reader = threading.Thread(
            target=output_reader,
            args=(process, launch_events),
            daemon=True,
        )
        reader.start()

        try:
            origin, token = wait_for_origin(launch_events, args.timeout)
            request_json(origin, "/__e2e/v1", None, expected=403)
            description = request_json(origin, "/__e2e/v1", token)
            action_names = {
                action.get("name") for action in description.get("actions", [])
            }
            expected_actions = {
                "activate",
                "move-forward",
                "move-backward",
                "turn-left",
                "turn-right",
                "target-next",
                "interact",
                "cancel",
                "skill-1",
                "probe-secure-input",
                "test-ui",
                "probe-layout",
            }
            if action_names != expected_actions:
                raise Failure(f"unexpected E2E action vocabulary: {sorted(action_names)}")
            if description.get("transport", {}).get("longPoll") is not True:
                raise Failure("the E2E API does not advertise long polling")

            game_description = request_json(origin, "/__game/v1", token)
            if game_description.get("actions", {}).get("available") is not False:
                raise Failure("the public game API unexpectedly advertises a write action")
            if game_description.get("transport", {}).get("longPoll") is not True:
                raise Failure("the game-state API does not advertise long polling")
            domains = set(game_description.get("state", {}).get("domains", []))
            if domains != {
                "player",
                "map",
                "target",
                "party",
                "skillbar",
                "effects",
                "agents",
                "quests",
                "inventory",
            }:
                raise Failure(f"unexpected game-state domains: {sorted(domains)}")
            request_json(origin, "/__game/v1/actions", token, expected=409)

            stream = EventStream(origin, token)
            milestones = stream.wait_for(
                {
                    "bridge-ready",
                    "client-capabilities",
                    "first-frame",
                    "login-ready",
                    "startup-complete",
                },
                args.timeout,
            )
            credential_status_event = stream.wait_optional("credential-status", 1)
            if credential_status_event is None:
                raise Failure("the host did not report profile credential status")
            credential_status = credential_status_event.get("detail", {}).get(
                "status"
            )
            credentials_event = stream.wait_optional("credentials-offered", 1)
            credentials_ready = credentials_event is not None
            if credentials_ready:
                credentials = credentials_event.get("detail", {})
                if credentials != {"accountSet": True, "passwordSet": True}:
                    raise Failure(
                        "the app did not offer a complete Keychain login to the client"
                    )
                print("[e2e] signed launch, Keychain, and first frame PASS")
            elif credential_status == "unavailable":
                print("[e2e] signed launch and first frame PASS; no Keychain login is stored")
            elif credential_status == "available":
                print(
                    "[e2e] signed launch and first frame PASS; the Keychain login "
                    "was not requested by the client"
                )
            elif credential_status == "error":
                raise Failure("the app could not inspect the profile Keychain login")
            else:
                raise Failure(f"unexpected credential status: {credential_status}")
            print("[e2e] token gates and event-driven API contracts PASS")

            secure_probe = submit_action(origin, token, "probe-secure-input")
            stream.wait_for_action(secure_probe, 5)
            secure_input = stream.wait_for_action_event(
                secure_probe,
                "secure-input-observed",
                1,
            )
            if (secure_input or {}).get("detail", {}).get("length") != 1:
                raise Failure("WebKit did not accept native input in a secure field")
            print("[e2e] native WebKit secure-input path PASS")

            if args.no_gameplay:
                ui = submit_action(origin, token, "test-ui")
                stream.wait_for_action(ui, 15)
                print("[e2e] semantic app UI PASS")
                print("[e2e] PASS (gameplay skipped)")
                return 0

            traffic = None
            login_response = None
            login_committed = None
            character_selection_ready = None
            if not credentials_ready:
                print(
                    "[e2e] enter the account password, enable Remember Password, "
                    "and choose Log In; waiting for authentication and 2FA"
                )
                login_committed = stream.wait_optional(
                    "login-committed",
                    args.auth_timeout,
                )
                login_response = stream.wait_optional("login-response", 1)
            else:
                # Enter activates the focused game control. Do not send another
                # one until the client commits the authenticated account and
                # presents character selection. While Connecting owns the
                # default control, a timer-driven second Enter cancels login.
                first = submit_action(origin, token, "activate")
                activation = stream.wait_for_action(first, 5)
                detail = activation.get("detail", {})
                prepared = stream.wait_for_action_event(first, "action-prepared", 1)
                observed = stream.wait_for_action_event(first, "native-key-observed", 1)
                released = stream.wait_for_action_event(first, "native-key-released", 1)
                print(
                    "[e2e] login activation "
                    f"{(prepared or {}).get('detail', {}).get('target', 'unknown')} -> "
                    f"{detail.get('target', 'unknown')} "
                    f"({(observed or {}).get('detail', {}).get('code', 'unobserved')}, "
                    f"keyCode={(observed or {}).get('detail', {}).get('keyCode', 'unknown')}, "
                    f"key-up={'observed' if released else 'missing'})"
                )
                traffic = stream.wait_for_action_traffic(
                    first,
                    8,
                    direction="send",
                )
                login_response = stream.wait_optional("login-response", 30)
                if traffic is None and login_response is None:
                    # A trusted Enter can arrive on the first frame before the
                    # painted login control owns it. No WebGate request and no
                    # socket send prove that Connecting never began, so one
                    # retry cannot hit its Cancel button.
                    print("[e2e] login produced no network work; retrying activation once")
                    first = submit_action(origin, token, "activate")
                    stream.wait_for_action(first, 5)
                    traffic = stream.wait_for_action_traffic(
                        first,
                        8,
                        direction="send",
                    )
                    login_response = stream.wait_optional("login-response", 30)
                if traffic is not None or login_response is not None:
                    print(
                        "[e2e] login network work started; waiting for authentication, "
                        "2FA, and character selection"
                    )
                    login_committed = stream.wait_optional(
                        "login-committed",
                        args.auth_timeout,
                    )

            capabilities = milestones["client-capabilities"].get("detail", {})
            ready = game_state_after(origin, token, 0, 0)
            state = (ready or {}).get("state", {})
            game_connection = None
            if login_committed is not None and state.get("status") != "ready":
                character_selection_ready = stream.wait_optional(
                    "character-selection-ready",
                    60,
                )
                if character_selection_ready is not None:
                    print(
                        "[e2e] authentication committed and character selection "
                        "settled; activating the selected character"
                    )
                    character = submit_action(origin, token, "activate")
                    stream.wait_for_action(character, 5)
                    game_connection = stream.wait_for_action_connection(
                        character,
                        30,
                    )
                    if game_connection is None:
                        print(
                            "[e2e] character activation opened no connection; "
                            "retrying once"
                        )
                        character = submit_action(origin, token, "activate")
                        stream.wait_for_action(character, 5)
                        game_connection = stream.wait_for_action_connection(
                            character,
                            30,
                        )
                    current = game_state_after(origin, token, 0, 0)
                    revision = int((current or {}).get("revision", 0))
                    ready = wait_for_ready_state(
                        origin,
                        token,
                        revision,
                        120,
                    )

            if ready is not None:
                state = ready.get("state", {})

            if (
                ready is not None
                and ready.get("state", {}).get("status") == "ready"
            ):
                print("[e2e] authenticated character entered the game")
            elif login_committed is not None:
                # Keep this distinct from a missing authentication connection:
                # the selected character was activated but certified telemetry
                # never became ready.
                state = (ready or {}).get("state", {})
                print(
                    "[e2e] character activation did not reach certified gameplay "
                    f"(status={state.get('status', 'unavailable')}, "
                    f"reason={state.get('reason', 'none')})"
                )

            if ready is None or ready.get("state", {}).get("status") != "ready":
                if capabilities.get("enhancements") == "ready":
                    probe = submit_action(origin, token, "probe-layout")
                    stream.wait_for_action(probe, 10)
                    probe_event = stream.wait_optional("layout-probe", 2)
                    if probe_event is not None:
                        detail = probe_event.get("detail", {})
                        print(
                            "[e2e] bounded layout probe "
                            f"context={detail.get('contextDeltas', [])} "
                            f"agents={detail.get('agentDeltas', [])} "
                            f"common={detail.get('commonDeltas', [])}"
                        )
                if credentials_ready:
                    if traffic:
                        print("[e2e] activation produced client socket send traffic")
                    else:
                        print(
                            "[e2e] activation reached the canvas; "
                            "no post-action socket traffic observed"
                        )
                if login_committed is None:
                    print("[e2e] the client never committed the authenticated account")
                elif character_selection_ready is None:
                    print(
                        "[e2e] authenticated socket traffic never settled at "
                        "character selection; Play was not sent"
                    )
                elif game_connection is None:
                    print("[e2e] character activation opened no attributable game connection")
                state = (ready or {}).get("state", {})
                status = state.get("status", "unavailable")
                reason = state.get("reason", "none")
                print(
                    "[e2e] authenticated gameplay did not become ready "
                    f"(certified telemetry status={status}, reason={reason})"
                )
                print("[e2e] INCONCLUSIVE (gameplay telemetry unavailable)")
                return 2

            state = ready["state"]
            party = state.get("party")
            skillbar = state.get("skillbar")
            effects = state.get("effects")
            agents = state.get("agents")
            quests = state.get("quests")
            inventory = state.get("inventory")
            if not isinstance(party, dict) or not party.get("players"):
                raise Failure("certified party state did not include the player roster")
            skills = skillbar.get("skills") if isinstance(skillbar, dict) else None
            if (
                skillbar is None
                or skillbar.get("agentId") != state.get("playerId")
                or not isinstance(skills, list)
                or len(skills) != 8
                or [skill.get("slot") for skill in skills] != list(range(1, 9))
                or not isinstance(skillbar.get("disabledMask"), int)
                or skillbar.get("disabledMask") & ~0xFF
                or not isinstance(skillbar.get("castCount"), int)
                or not 0 <= skillbar.get("castCount") <= 64
                or skillbar.get("casting") != (skillbar.get("castCount") != 0)
                or any(
                    skill.get("disabled")
                    != bool(skillbar.get("disabledMask") & (1 << index))
                    for index, skill in enumerate(skills)
                )
                or not any(skill.get("skillId", 0) > 0 for skill in skills)
            ):
                raise Failure("certified player skillbar state is incomplete")
            buffs = effects.get("buffs") if isinstance(effects, dict) else None
            active_effects = effects.get("effects") if isinstance(effects, dict) else None
            if (
                effects is None
                or effects.get("agentId") != state.get("playerId")
                or not isinstance(buffs, list)
                or len(buffs) > 32
                or not isinstance(active_effects, list)
                or len(active_effects) > 64
                or any(not isinstance(buff, dict) for buff in buffs)
                or any(not isinstance(effect, dict) for effect in active_effects)
                or effects.get("buffsTruncated") not in (True, False)
                or effects.get("effectsTruncated") not in (True, False)
                or (effects.get("buffsTruncated") and len(buffs) != 32)
                or (effects.get("effectsTruncated") and len(active_effects) != 64)
                or len({buff.get("buffId") for buff in buffs}) != len(buffs)
                or len({effect.get("effectId") for effect in active_effects})
                != len(active_effects)
            ):
                raise Failure("certified player effects state is incomplete")
            map_agents = agents.get("agents") if isinstance(agents, dict) else None
            if (
                agents is None
                or not isinstance(map_agents, list)
                or not map_agents
                or len(map_agents) > 128
                or not isinstance(agents.get("total"), int)
                or agents.get("total") < len(map_agents)
                or agents.get("total") > 4_095
                or agents.get("truncated") not in (True, False)
                or (agents.get("truncated") and len(map_agents) != 128)
                or (
                    not agents.get("truncated")
                    and agents.get("total") != len(map_agents)
                )
                or [agent.get("agentId") for agent in map_agents]
                != sorted({agent.get("agentId") for agent in map_agents})
                or not any(
                    agent.get("agentId") == state.get("playerId")
                    and agent.get("isLiving") is True
                    for agent in map_agents
                )
            ):
                raise Failure("certified map-agent state is incomplete")
            quest_log = quests.get("quests") if isinstance(quests, dict) else None
            objectives = (
                quests.get("missionObjectives")
                if isinstance(quests, dict)
                else None
            )
            if (
                quests is None
                or not isinstance(quests.get("activeQuestId"), int)
                or not 0 <= quests.get("activeQuestId") <= 100_000
                or quests.get("questsTruncated") not in (True, False)
                or quests.get("objectivesTruncated") not in (True, False)
                or not isinstance(quest_log, list)
                or len(quest_log) > 64
                or not isinstance(objectives, list)
                or len(objectives) > 32
                or (quests.get("questsTruncated") and len(quest_log) != 64)
                or (
                    quests.get("objectivesTruncated")
                    and len(objectives) != 32
                )
                or len({quest.get("questId") for quest in quest_log})
                != len(quest_log)
                or len(
                    {
                        objective.get("objectiveId")
                        for objective in objectives
                    }
                )
                != len(objectives)
            ):
                raise Failure("certified quest state is incomplete")
            bags = (
                inventory.get("bags")
                if isinstance(inventory, dict)
                else None
            )
            items = (
                inventory.get("items")
                if isinstance(inventory, dict)
                else None
            )
            item_locations = (
                [(item.get("bagId"), item.get("slot")) for item in items]
                if isinstance(items, list)
                and all(isinstance(item, dict) for item in items)
                else []
            )
            if (
                inventory is None
                or inventory.get("itemsTruncated") not in (True, False)
                or not isinstance(inventory.get("total"), int)
                or not 0 <= inventory.get("total") <= 1_024
                or not isinstance(inventory.get("goldCharacter"), int)
                or not isinstance(inventory.get("goldStorage"), int)
                or not isinstance(inventory.get("storagePanesUnlocked"), int)
                or not 0 <= inventory.get("storagePanesUnlocked") <= 14
                or not isinstance(bags, list)
                or not 1 <= len(bags) <= 22
                or any(not isinstance(bag, dict) for bag in bags)
                or any(not isinstance(bag.get("bagId"), int) for bag in bags)
                or not isinstance(items, list)
                or len(items) > 512
                or any(not isinstance(item, dict) for item in items)
                or any(
                    not isinstance(item.get("itemId"), int)
                    or not isinstance(item.get("bagId"), int)
                    or not isinstance(item.get("slot"), int)
                    for item in items
                )
                or inventory.get("total") < len(items)
                or (
                    inventory.get("itemsTruncated")
                    and (
                        len(items) != 512
                        or inventory.get("total") <= len(items)
                    )
                )
                or (
                    not inventory.get("itemsTruncated")
                    and inventory.get("total") != len(items)
                )
                or [bag.get("bagId") for bag in bags]
                != sorted({bag.get("bagId") for bag in bags})
                or 1 not in {bag.get("bagId") for bag in bags}
                or len({item.get("itemId") for item in items}) != len(items)
                or item_locations != sorted(set(item_locations))
            ):
                raise Failure("certified inventory state is incomplete")
            print(
                "[e2e] party, skillbar, effects, agents, quests, and inventory API PASS "
                f"(players={len(party.get('players', []))}, "
                f"heroes={len(party.get('heroes', []))}, "
                f"henchmen={len(party.get('henchmen', []))}, "
                f"populated-skills={sum(skill.get('skillId', 0) > 0 for skill in skills)}, "
                f"buffs={len(buffs)}, effects={len(active_effects)}, "
                f"agents={len(map_agents)}/{agents.get('total')}, "
                f"quests={len(quest_log)}, objectives={len(objectives)}, "
                f"items={len(items)}/{inventory.get('total')}, "
                f"bags={len(bags)})"
            )

            before = position(ready)
            revision = int(ready["revision"])
            ui = submit_action(origin, token, "test-ui")
            stream.wait_for_action(ui, 15)
            print("[e2e] in-game app widgets PASS")

            for action, duration in [
                ("target-next", None),
                ("interact", None),
                ("cancel", None),
                ("skill-1", None),
                ("turn-left", 200),
                ("turn-right", 200),
            ]:
                sequence = submit_action(origin, token, action, duration)
                stream.wait_for_action(sequence, 5)
            print("[e2e] target, interact, cancel, skill, and turning inputs PASS")

            movement = submit_action(origin, token, "move-forward", 800)
            stream.wait_for_action(movement, 5)
            forward = wait_for_position_change(
                origin,
                token,
                before,
                revision,
                15,
            )
            latest = game_state_after(origin, token, 0, 0)
            backward_revision = int((latest or {}).get("revision", revision))
            backward = submit_action(origin, token, "move-backward", 800)
            stream.wait_for_action(backward, 5)
            wait_for_position_change(
                origin,
                token,
                forward,
                backward_revision,
                15,
            )
            print("[e2e] authenticated character and bidirectional movement PASS")
            print("[e2e] PASS")
            return 0
        finally:
            terminate(process)
            try:
                inhibitor.wait(timeout=2)
            except subprocess.TimeoutExpired:
                inhibitor.terminate()
                inhibitor.wait(timeout=2)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("[e2e] interrupted", file=sys.stderr)
        raise SystemExit(130)
    except (Failure, subprocess.CalledProcessError) as error:
        print(f"[e2e] FAIL: {error}", file=sys.stderr)
        raise SystemExit(1)
